{
  "name": "nuxt-app",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gameboard-timer \"vitest run --config vitest.rules.config.mjs\"",
    "typecheck": "nuxi typecheck",
    "size": "node scripts/check-bundle-size.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@nuxt/devtools": "^4.1.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "firebase-tools": "15.35.0",
    "nuxt": "^4.6.4",
    "typescript": "6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.3",
    "bootstrap": "^5.3.8",
    "firebase": "^13.2.0",
    "pinia": "^4.1.0",
    "sass": "^1.108.2"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
